# Line endings
#
# Without this, each machine's core.autocrlf decides how files are stored and
# checked out, which is why `git add` on Windows warned about LF -> CRLF on
# every text file. Declaring it here makes the behaviour a property of the
# repository rather than of whoever happens to clone it.
#
# The repository already stores LF, so this changes nothing in history — it
# just stops it depending on local configuration.

* text=auto eol=lf

# ----------------------------------------------------------------- source
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.jsonc   text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.svg     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.env*    text eol=lf

# Shell scripts must keep LF or they fail to execute on Unix hosts,
# including most CI runners and the deployment target.
*.sh      text eol=lf
*.bash    text eol=lf

# Windows-only scripts are the one exception — these need CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# ----------------------------------------------------------------- binary
# Marking these prevents any line-ending conversion (which corrupts binary
# files) and stops Git attempting to diff them.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.avif    binary
*.ico     binary
*.bmp     binary
*.pdf     binary
*.mp4     binary
*.webm    binary
*.mov     binary
*.mp3     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.eot     binary
*.zip     binary

# ------------------------------------------------------------- generated
# Excluded from GitHub's language statistics so the repo is reported as the
# TypeScript project it is. Diffing is deliberately left ON: a lockfile diff
# is how you spot an unexpected dependency change during review.
package-lock.json  linguist-generated=true
